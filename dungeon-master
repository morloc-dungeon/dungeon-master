#!/usr/bin/env python3
"""dungeon-master -- admin/curation tool for the morloc-dungeon org.

Clones the demo repositories, runs their Makefile-driven tests against the
active morloc version, and bundles the passing demos into a single release
tarball plus a manifest. See DESIGN.md for the full rationale.

This is an admin tool, not the tool a learner runs. The learner-facing path is
`mim demos`, which consumes the release tarball produced here.

Membership rule: a directory under the repos dir is a demo iff it contains a
TAGS file with at least one valid tag. A directory with no TAGS file is silently
ignored, and the org's non-demo repos (SKIP) are never cloned or tested.

The repos dir defaults to `repos/` beside this script (where `clone` puts the
org's repos) and can be pointed anywhere with `--repos-dir`, e.g. at a checkout
holding unpushed demos: `dungeon-master --repos-dir .. test`. A `.git` is only
needed for `release`, which cites and archives the tested commit.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

ORG = "morloc-dungeon"

# Directories relative to this script.
ROOT = Path(__file__).resolve().parent
DEFAULT_REPOS_DIR = ROOT / "repos"  # where `clone` puts the org's repos
DIST_DIR = ROOT / "dist"        # release artifacts (tarball + manifest)
ALLOW_FAIL_FILE = ROOT / "allow-fail"  # demos permitted to fail without halting
VERSION_FILE = ROOT / "VERSION"        # this tool's version; `v<VERSION>` tags a release

# Set from --repos-dir in main() before any subcommand runs.
REPOS_DIR = DEFAULT_REPOS_DIR

# Org repos that carry a TAGS file but are not demos: this tool, and the
# template a new demo is copied from.
SKIP = {"dungeon-master", "template"}

TAG_RE = re.compile(r"^[A-Za-z0-9_-]+$")


# --------------------------------------------------------------------------
# small helpers
# --------------------------------------------------------------------------

def info(msg):
    print(msg, file=sys.stderr)


def die(msg, code=1):
    print(f"dungeon-master: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, cwd=None, capture=False):
    """Run a command. Returns (returncode, stdout, stderr)."""
    proc = subprocess.run(
        cmd,
        cwd=cwd,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        text=True,
    )
    return proc.returncode, (proc.stdout or ""), (proc.stderr or "")


# --------------------------------------------------------------------------
# GitHub org enumeration (admin side: the REST API is fine here -- a token
# lifts the rate limit, and this is not the cost-sensitive learner path)
# --------------------------------------------------------------------------

def github_get(url):
    req = urllib.request.Request(url)
    req.add_header("Accept", "application/vnd.github+json")
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read().decode())


def list_org_repos():
    """Names of every non-archived repo in the org. Demo membership is decided
    later, by the presence of a valid TAGS file after cloning."""
    repos = []
    page = 1
    while True:
        url = f"https://api.github.com/orgs/{ORG}/repos?per_page=100&page={page}"
        try:
            batch = github_get(url)
        except Exception as e:  # noqa: BLE001 -- report and stop, do not mask
            die(f"could not list org repos from GitHub: {e}")
        if not batch:
            break
        repos.extend(r["name"] for r in batch if not r.get("archived", False))
        page += 1
    return sorted(repos)


# --------------------------------------------------------------------------
# local repo inspection / membership
# --------------------------------------------------------------------------

def candidate_dirs():
    """Directories under the repos dir that could be demos, minus SKIP. No
    `.git` is required, so a local checkout of unpushed work is testable."""
    if not REPOS_DIR.is_dir():
        return []
    return sorted(p.name for p in REPOS_DIR.iterdir()
                  if p.is_dir() and not p.name.startswith(".") and p.name not in SKIP)


def is_git_repo(repo):
    return (REPOS_DIR / repo / ".git").is_dir()


def parse_tags(repo):
    """Tags declared in a repo's TAGS file, or None if the file is absent.

    An empty-but-present TAGS file yields [] (a present-but-untagged repo, which
    is not a valid demo). Invalid tag names abort with an error.
    """
    tags_file = REPOS_DIR / repo / "TAGS"
    if not tags_file.is_file():
        return None
    tags = []
    for line in tags_file.read_text().splitlines():
        tag = line.strip()
        if not tag or tag.startswith("#"):
            continue
        if not TAG_RE.match(tag):
            die(f"{repo}: invalid tag {tag!r} (allowed: letters, digits, '-', '_')")
        if tag not in tags:
            tags.append(tag)
    return tags


def demo_repos(tag=None):
    """Directories that are demos (have >=1 valid tag), optionally tag-filtered."""
    out = []
    for repo in candidate_dirs():
        tags = parse_tags(repo)
        if tags:  # non-None and non-empty
            if tag is None or tag in tags:
                out.append(repo)
    return out


def git_hash(repo):
    if not is_git_repo(repo):
        die(f"{repo} is not a git repository; a release cites the tested commit")
    code, out, _ = run(["git", "rev-parse", "HEAD"], cwd=REPOS_DIR / repo, capture=True)
    if code != 0:
        die(f"could not read HEAD of {repo}")
    return out.strip()


def read_synopsis(repo):
    """The one-line `synopsis:` from a repo's package.yaml, or "" if absent.

    `synopsis` is morloc's short-description field (see PackageMeta in the
    compiler's Namespace/State.hs; `description` is the longer one). This is a
    deliberately minimal scan -- the script is stdlib-only, no YAML parser --
    but package.yaml keys are top-level and unindented, so a bare `synopsis:`
    line is unambiguous. Tabs/newlines are stripped so the value stays a single
    manifest column.
    """
    pkg = REPOS_DIR / repo / "package.yaml"
    if not pkg.is_file():
        return ""
    for line in pkg.read_text().splitlines():
        m = re.match(r"synopsis\s*:\s*(.*)", line)
        if m:
            s = m.group(1).strip().strip('"').strip("'")
            return s.replace("\t", " ").replace("\n", " ")
    return ""


def read_allow_fail():
    """Repo names permitted to fail without halting a release."""
    if not ALLOW_FAIL_FILE.is_file():
        return set()
    names = set()
    for line in ALLOW_FAIL_FILE.read_text().splitlines():
        name = line.strip()
        if name and not name.startswith("#"):
            names.add(name)
    return names


# --------------------------------------------------------------------------
# clone / update
# --------------------------------------------------------------------------

def clone_or_update(repo):
    dest = REPOS_DIR / repo
    if is_git_repo(repo):
        info(f"updating {repo}")
        run(["git", "fetch", "--quiet", "origin"], cwd=dest)
        run(["git", "reset", "--hard", "--quiet", "origin/HEAD"], cwd=dest)
    else:
        info(f"cloning {repo}")
        url = f"https://github.com/{ORG}/{repo}.git"
        code, _, _ = run(["git", "clone", "--quiet", url, str(dest)])
        if code != 0:
            die(f"git clone failed for {repo}")


# --------------------------------------------------------------------------
# morloc version / make
# --------------------------------------------------------------------------

def active_morloc_version():
    code, out, _ = run(["morloc", "--version"], capture=True)
    if code != 0:
        die("could not run `morloc --version` (is morloc installed and on PATH?)")
    return out.strip()


def make_test(repo):
    """Run `make clean` then `make test`. Returns (passed, log)."""
    dest = REPOS_DIR / repo
    run(["make", "clean"], cwd=dest, capture=True)
    code, out, err = run(["make", "test"], cwd=dest, capture=True)
    return code == 0, out + err


# --------------------------------------------------------------------------
# release bundling
# --------------------------------------------------------------------------

def bundle_sources(items, staging):
    """Export each repo's committed tree at a specific commit (no .git, no build
    junk) under staging/<repo>/. `items` is a list of (repo, ref); archiving by
    the exact tested commit guarantees the bundle matches what was tested."""
    for repo, ref in items:
        dest = staging / repo
        dest.mkdir(parents=True)
        # Pipe `git archive <ref>` into `tar -x`: the committed tree only, so no
        # .git and no build junk. Shell-free two-process pipe.
        p1 = subprocess.Popen(
            ["git", "archive", "--format=tar", ref],
            cwd=REPOS_DIR / repo, stdout=subprocess.PIPE,
        )
        p2 = subprocess.Popen(["tar", "-x", "-C", str(dest)], stdin=p1.stdout)
        p1.stdout.close()
        if p2.wait() != 0 or p1.wait() != 0:
            die(f"could not stage sources for {repo} at {ref}")


def write_manifest(path, version, rows):
    """rows: list of (repo, hash, tags-list), written sorted by repo. Each line
    is `repo<TAB>hash<TAB>tags<TAB>synopsis`; the synopsis is read here so a
    consumer (mim demos --list) can show it without unpacking the tarball."""
    lines = [f"# morloc-version: {version}"]
    for repo, h, tags in sorted(rows, key=lambda r: r[0]):
        lines.append(f"{repo}\t{h}\t{','.join(tags)}\t{read_synopsis(repo)}")
    path.write_text("\n".join(lines) + "\n")


# --------------------------------------------------------------------------
# per-runner test reports (consumed by `bundle` to reconcile across platforms)
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# subcommands
# --------------------------------------------------------------------------

def cmd_list(args):
    repos = demo_repos(args.tag)
    if not repos:
        die("no matching demos under the repos dir")
    for repo in repos:
        print(f"{repo}\t{','.join(parse_tags(repo))}")


def cmd_clone(args):
    REPOS_DIR.mkdir(parents=True, exist_ok=True)
    for repo in list_org_repos():
        if repo not in SKIP:
            clone_or_update(repo)
    demos = demo_repos(args.tag)
    info(f"{len(demos)} demo repo(s)"
         + (f" tagged '{args.tag}'" if args.tag else ""))


def cmd_update(args):
    repos = [r for r in (demo_repos(args.tag) or candidate_dirs()) if is_git_repo(r)]
    if not repos:
        die("no cloned repos; run `dungeon-master clone` first")
    for repo in repos:
        clone_or_update(repo)


def _run_corpus(repos, allow_fail):
    """Test every repo. Returns (passing, blocking): the repos that passed, and
    the repos that failed and are not on allow-fail. An allow-fail repo that
    fails is simply excluded from passing."""
    passing, blocking = [], []
    for repo in repos:
        ok, log = make_test(repo)
        if ok:
            info(f"  pass {repo}")
            passing.append(repo)
            continue
        if repo in allow_fail:
            info(f"  FAIL {repo}  (allow-fail: excluded)")
        else:
            info(f"  FAIL {repo}  (blocks the release)")
            blocking.append(repo)
        # The captured `make test` output, so the failure is diagnosable from
        # this run alone (a CI log, or a terminal) without re-running make.
        for line in log.rstrip("\n").splitlines():
            info(f"    | {line}")
    return passing, blocking


def cmd_test(args):
    repos = demo_repos(args.tag)
    if not repos:
        die("no matching demos under the repos dir")
    version = active_morloc_version()
    info(f"testing {len(repos)} demo(s) under {REPOS_DIR} against morloc {version}")
    _, blocking = _run_corpus(repos, read_allow_fail())
    if blocking:
        die(f"{len(blocking)} demo(s) failed: {', '.join(blocking)}")


def cmd_release(args):
    """Gate the whole corpus against the active morloc, and (with --bundle)
    produce the release tarball + manifest.

    Both CI runners call this to gate: any failing demo not on allow-fail exits
    nonzero, which fails the runner and -- via GitHub Actions -- cancels the
    release. Only one runner (Linux; the bundle is OS-agnostic source) passes
    --bundle to also write the artifacts."""
    version = active_morloc_version()
    if args.morloc_version and args.morloc_version != version:
        die(f"active morloc is {version} but --morloc-version says "
            f"{args.morloc_version}; provision {args.morloc_version} first")

    repos = demo_repos()  # a release always covers the whole corpus
    if not repos:
        die("no demo repos; run `dungeon-master clone` first")
    for repo in repos:
        git_hash(repo)  # refuse up front rather than after a long test run

    info(f"release: testing {len(repos)} demo(s) under {REPOS_DIR} against morloc {version}")
    passing, blocking = _run_corpus(repos, read_allow_fail())
    if blocking:
        die(f"release halted: {len(blocking)} demo(s) failed and are not on "
            f"allow-fail: {', '.join(blocking)}")

    if not args.bundle:
        info(f"release: {len(passing)} demo(s) green (no --bundle; gate only)")
        return
    rows = [(r, git_hash(r), parse_tags(r)) for r in passing]

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    tarball = out / "demos.tar.gz"
    manifest = out / "manifest.tsv"
    with tempfile.TemporaryDirectory() as tmp:
        staging = Path(tmp) / "demos"
        staging.mkdir()
        bundle_sources([(r, h) for r, h, _ in rows], staging)
        code, _, _ = run(["tar", "-czf", str(tarball), "-C", str(staging.parent),
                          staging.name])
        if code != 0:
            die("could not create release tarball")
    write_manifest(manifest, version, rows)
    info(f"release: {len(passing)} demo(s) bundled for morloc {version}")
    info(f"  {tarball}")
    info(f"  {manifest}")


# --------------------------------------------------------------------------
# deploy: gate, bump, tag, push
# --------------------------------------------------------------------------

def git_out(args, cwd):
    """stdout of a git command, or die."""
    code, out, err = run(["git", *args], cwd=cwd, capture=True)
    if code != 0:
        die(f"git {' '.join(args)} failed in {cwd}: {err.strip()}")
    return out.strip()


def read_version():
    if not VERSION_FILE.is_file():
        die(f"no VERSION file at {VERSION_FILE}")
    v = VERSION_FILE.read_text().strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+", v):
        die(f"VERSION is {v!r}; expected MAJOR.MINOR.PATCH")
    return v


def bump_version(version, part):
    major, minor, patch = (int(x) for x in version.split("."))
    if part == "minor":
        return f"{major}.{minor + 1}.0"
    return f"{major}.{minor}.{patch + 1}"


def check_demo_published(repo):
    """A demo's HEAD must be committed, pushed, and what origin's default branch
    points at: the release workflow tests the org's clones, not this checkout,
    so anything local-only is tested here and silently not there."""
    dest = REPOS_DIR / repo
    if not is_git_repo(repo):
        die(f"{repo} is not a git repository; the release tests the org's clone of it")
    if git_out(["status", "--porcelain"], dest):
        die(f"{repo} has uncommitted changes; commit and push them first")
    head = git_out(["rev-parse", "HEAD"], dest)
    # Ask the remote itself rather than a fetched ref: `origin/HEAD` exists only
    # after a clone, and a demo created locally and pushed has none.
    remote = git_out(["ls-remote", "origin", "HEAD"], dest).split()
    if not remote:
        die(f"{repo}: origin has no HEAD (is the repo pushed?)")
    if head != remote[0]:
        die(f"{repo}: HEAD {head[:8]} is not what origin serves ({remote[0][:8]}); "
            f"push it first")


def cmd_deploy(args):
    """Bump VERSION, tag `v<VERSION>`, and push the tag, after gating the corpus
    here. The tag push runs the release workflow, which tests the org's clones
    on both OSes and publishes the demos bundle; this command is the local half
    of that, and refuses to tag anything CI would test differently."""
    if git_out(["status", "--porcelain"], ROOT):
        die("dungeon-master has uncommitted changes; the version bump must be "
            "the only change in the release commit")
    branch = git_out(["rev-parse", "--abbrev-ref", "HEAD"], ROOT)
    if branch != "main":
        die(f"on branch {branch}; releases are tagged from main")

    repos = demo_repos()
    if not repos:
        die("no demo repos under the repos dir")
    for repo in repos:
        check_demo_published(repo)

    version = active_morloc_version()
    info(f"deploy: testing {len(repos)} demo(s) under {REPOS_DIR} "
         f"against morloc {version}")
    passing, blocking = _run_corpus(repos, read_allow_fail())
    if blocking:
        die(f"release halted: {len(blocking)} demo(s) failed and are not on "
            f"allow-fail: {', '.join(blocking)}")
    info(f"deploy: {len(passing)} demo(s) green")

    old = read_version()
    new = bump_version(old, args.part)
    tag = f"v{new}"
    code, _, _ = run(["git", "rev-parse", "--verify", "--quiet", f"refs/tags/{tag}"],
                     cwd=ROOT, capture=True)
    if code == 0:
        die(f"tag {tag} already exists")
    if args.dry_run:
        info(f"deploy: would bump {old} -> {new}, tag {tag}, and push (dry run)")
        return

    VERSION_FILE.write_text(new + "\n")
    git_out(["add", str(VERSION_FILE)], ROOT)
    git_out(["commit", "--quiet", "-m", f"Release {tag}"], ROOT)
    git_out(["tag", tag], ROOT)
    git_out(["push", "--quiet", "origin", "main", tag], ROOT)
    info(f"deploy: {old} -> {new}; pushed {tag}")
    info("  the Dungeon Release workflow now gates on both OSes and publishes "
         "the bundle")


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="dungeon-master",
        description="Admin/curation tool for the morloc-dungeon org.",
    )
    repos_help = ("directory holding the demo folders, one per demo "
                  f"(default {DEFAULT_REPOS_DIR}); relative to the cwd")
    p.add_argument("--repos-dir", default=str(DEFAULT_REPOS_DIR), help=repos_help)

    # The same option on every subcommand, so it shows in `<cmd> -h` and may
    # follow the subcommand. SUPPRESS keeps the subparser from overwriting a
    # value given before the subcommand with its own default.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--repos-dir", default=argparse.SUPPRESS, help=repos_help)

    sub = p.add_subparsers(dest="command", required=True)

    def add_tag(sp):
        sp.add_argument("--tag", help="restrict to demos carrying this tag")

    sp = sub.add_parser("list", parents=[common], help="list demos and their tags")
    add_tag(sp)
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("clone", parents=[common], help="clone/update all demo repos")
    add_tag(sp)
    sp.set_defaults(func=cmd_clone)

    sp = sub.add_parser("update", parents=[common], help="update already-cloned repos")
    add_tag(sp)
    sp.set_defaults(func=cmd_update)

    sp = sub.add_parser("test", parents=[common],
                        help="run each demo's tests against active morloc")
    add_tag(sp)
    sp.set_defaults(func=cmd_test)

    sp = sub.add_parser("release", parents=[common],
                        help="gate the corpus; with --bundle, write the tarball")
    sp.add_argument("--bundle", action="store_true",
                    help="also write demos.tar.gz + manifest.tsv (one runner only)")
    sp.add_argument("--out", default=str(DIST_DIR),
                    help=f"output directory for artifacts (default {DIST_DIR})")
    sp.add_argument("--morloc-version",
                    help="assert the active compiler is this version")
    sp.set_defaults(func=cmd_release)

    sp = sub.add_parser("deploy", parents=[common],
                        help="gate the corpus here, bump VERSION, tag, and push")
    sp.add_argument("part", nargs="?", choices=["minor", "patch"], default="patch",
                    help="which version component to bump (default patch)")
    sp.add_argument("--dry-run", action="store_true",
                    help="gate and report the bump without committing or pushing")
    sp.set_defaults(func=cmd_deploy)

    return p


def main():
    global REPOS_DIR
    args = build_parser().parse_args()
    REPOS_DIR = Path(args.repos_dir).resolve()
    args.func(args)


if __name__ == "__main__":
    main()
